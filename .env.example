# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 비밀번호를 채워 넣는다.
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 저장소에 올라가지 않는다.
# ─────────────────────────────────────────────────────────────

# ⚠️ 비밀번호 복잡도 요구사항 (양쪽 모두 해당)
#    대문자 + 소문자 + 숫자 + 특수문자를 포함한 8자 이상.
#    미충족 시 컨테이너가 에러 메시지 없이 조용히 죽는다. (README 함정 #1)

# MSSQL SA 비밀번호
MSSQL_SA_PASSWORD=CHANGE_ME_Str0ng!Pass

# OpenSearch 초기 admin 비밀번호
#  - 2.12 부터 필수. 미설정 시 부팅 중 종료된다.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME_Str0ng!Pass

# 회사(테넌트) 관리자 계정 비밀번호 — opensearch/setup-security.sh 가 이 값으로 계정을 만든다
COMPANY1_ADMIN_PASSWORD=CHANGE_ME_Comp1!Pass
COMPANY2_ADMIN_PASSWORD=CHANGE_ME_Comp2!Pass

# OpenSearch JVM 힙.
#  - Docker Desktop 메모리가 8GB 근처면 512m, 12GB 이상이면 1g 로 올려도 된다.
#  - Xms 와 Xmx 는 반드시 같은 값으로 둘 것.
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# Grafana admin 비밀번호 (Loki 비교 구성에서만 사용)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_Graf4na!Pass
